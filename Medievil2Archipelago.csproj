<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>medievil.ico</ApplicationIcon>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- Keep external/ (checked-out Archipelago.Core source) out of this project's own compile/globs -->
  <ItemGroup>
    <Compile Remove="external\**" />
    <Content Remove="external\**" />
    <EmbeddedResource Remove="external\**" />
    <None Remove="external\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\MediEvilFont.ttf" />
  </ItemGroup>

  <ItemGroup>
	  <Content Include="appsettings.Local.json" Condition="Exists('appsettings.Local.json')">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </Content>
	  <Content Include="Assets\MediEvilFont.ttf">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
	  <Content Include="medievil.ico" />
  </ItemGroup>

  <!-- Local dev machine: use your local fork checkout if present -->
  <ItemGroup Condition="Exists('D:\Archipelago\dev\Archipelago.core.myrepo\Archipelago.Core\Archipelago.Core.csproj')">
    <ProjectReference Include="D:\Archipelago\dev\Archipelago.core.myrepo\Archipelago.Core\Archipelago.Core.csproj" />
  </ItemGroup>

  <!-- CI / anyone else: use the copy of main checked out by the workflow -->
  <ItemGroup Condition="!Exists('D:\Archipelago\dev\Archipelago.core.myrepo\Archipelago.Core\Archipelago.Core.csproj') AND Exists('$(MSBuildThisFileDirectory)external\Archipelago.Core\Archipelago.Core.csproj')">
    <ProjectReference Include="$(MSBuildThisFileDirectory)external\Archipelago.Core\Archipelago.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Kokuban" Version="0.2.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.7" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.7" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".github\workflows\release.yml" />
  </ItemGroup>

</Project>
